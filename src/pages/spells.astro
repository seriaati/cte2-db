---
import SpellBrowser from '../components/SpellBrowser.tsx';
import Layout from '../layouts/Layout.astro';
import { maxLevel } from '../lib/gear';
import { bonusLevels, classIcons, costScaling, spells } from '../lib/spells';
import '../styles/lists.css';
import '../styles/spells.css';
---

<Layout title="CTE2 Spells | Craft to Exile 2 Database" description="Every spell the classes of Craft to Exile 2 teach, with its damage scaling, mana and energy cost, cooldown, cast time and level requirement.">
  <SpellBrowser client:load spells={spells} classIcons={classIcons} bonusLevels={bonusLevels} costScaling={costScaling} maxLevel={maxLevel} />
</Layout>
