---
import pack from '../data/pack.json';
import Layout from '../layouts/Layout.astro';

const structuredData = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'CTE2 Database',
  alternateName: 'Craft to Exile 2 Database',
  url: Astro.site,
});
const source = [pack.version && `Craft to Exile 2 ${pack.version}`, pack.mod && `Mine and Slash ${pack.mod}`].filter(Boolean);
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={structuredData} />
  <div class="home">
    <h1>CTE2 Database</h1>
    <p class="cap home-source">{source.join(' / ')}</p>
    <div class="home-search">
      <input class="in" type="search" placeholder="Search pages, items, stats" aria-label="Search" autocomplete="off" spellcheck="false" enterkeyhint="go" />
      <div class="search-results"></div>
    </div>
    <section class="home-recent" hidden>
      <h2 class="cap">Recently viewed</h2>
      <div class="recent-rows"></div>
    </section>
  </div>
</Layout>
