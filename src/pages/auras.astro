---
import AuraBrowser from '../components/AuraBrowser.tsx';
import Layout from '../layouts/Layout.astro';
import { auras } from '../lib/auras';
import { maxLevel, rarities } from '../lib/gear';
import '../styles/lists.css';
---

<Layout title="Augments" description="Every Augment gem in Craft to Exile 2, with its stats by rarity and level, the capacity it reserves and the level it needs.">
  <AuraBrowser client:load auras={auras} rarities={rarities} maxLevel={maxLevel} />
</Layout>
