---
import '@fontsource/jersey-15/latin-400.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-600.css';
import headingFont from '@fontsource/jersey-15/files/jersey-15-latin-400-normal.woff2?url';
import bodyFont from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import '../styles/global.css';

// What goes in every page's <head>: the database pages and the build editor share it.
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CTE2 Database | Craft to Exile 2 Modpack Database and Gear Planner',
  description = 'CTE2 Database is a searchable gear database for the Craft to Exile 2 modpack: a gear planner, affixes, uniques, runes, gems, augments, support gems, infusions, jewels, spells, status effects and stats.',
} = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og-2.png', Astro.site);
---

<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="viewport" content="width=device-width" />
<meta name="theme-color" content="#17191a" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="CTE2 Database" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="CTE2 Database: gear planner, affixes, uniques, runes, gems and stats for Craft to Exile 2" />
<meta name="twitter:card" content="summary_large_image" />
<link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
