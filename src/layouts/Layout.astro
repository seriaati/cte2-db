---
import { ClientRouter } from 'astro:transitions';
import '@fontsource/jersey-15/latin-400.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-600.css';
import headingFont from '@fontsource/jersey-15/files/jersey-15-latin-400-normal.woff2?url';
import bodyFont from '@fontsource/space-grotesk/files/space-grotesk-latin-400-normal.woff2?url';
import { auras } from '../lib/auras';
import { affixes, bases, infusions } from '../lib/gear';
import { gems } from '../lib/gems';
import { jewelAffixes } from '../lib/jewels';
import { runes } from '../lib/runes';
import { spells } from '../lib/spells';
import { stats } from '../lib/stats';
import { supports } from '../lib/supports';
import { talents } from '../lib/talents';
import { uniques } from '../lib/uniques';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CTE2 Database | Craft to Exile 2 Gear Planner and Affixes',
  description = 'CTE2 Database is a searchable gear database for the Craft to Exile 2 modpack: a gear planner, affixes, uniques, runes, gems, augments, support gems, infusions, jewels, spells and stats.',
} = Astro.props;
const path = Astro.url.pathname;
const url = new URL(path, Astro.site);
const image = new URL('/og.png', Astro.site);
// Each icon is drawn on an 8 x 8 pixel grid. The number is how many entries the page lists.
const nav: [href: string, label: string, icon: string, count?: number][] = [
  ['/planner', 'Gear planner', 'M1 1h7v1h-7zM0 2h8v1h-8zM2 3h5v1h-5zM3 4h3v1h-3zM3 5h3v1h-3zM2 6h5v1h-5zM1 7h7v1h-7z'],
  ['/affixes', 'Affixes', 'M0 0h4v1h-4zM0 1h1v1h-1zM2 1h3v1h-3zM0 2h6v1h-6zM0 3h7v1h-7zM1 4h6v1h-6zM2 5h4v1h-4zM3 6h2v1h-2z', affixes.length],
  ['/bases', 'Base gear', 'M1 1h2v1h-2zM5 1h2v1h-2zM0 2h2v1h-2zM3 2h2v1h-2zM6 2h2v1h-2zM0 3h8v1h-8zM2 4h4v1h-4zM2 5h4v1h-4zM2 6h4v1h-4z', bases.length],
  ['/uniques', 'Uniques', 'M0 0h1v1h-1zM7 0h1v1h-1zM0 1h2v1h-2zM3 1h2v1h-2zM6 1h2v1h-2zM0 2h8v1h-8zM1 3h6v1h-6zM1 4h1v1h-1zM3 4h2v1h-2zM6 4h1v1h-1zM1 5h1v1h-1zM3 5h2v1h-2zM6 5h1v1h-1zM1 6h6v1h-6z', uniques.length],
  ['/runes', 'Runes', 'M1 0h6v1h-6zM0 1h8v1h-8zM0 2h2v1h-2zM3 2h2v1h-2zM6 2h2v1h-2zM0 3h2v1h-2zM6 3h2v1h-2zM0 4h2v1h-2zM3 4h2v1h-2zM6 4h2v1h-2zM0 5h2v1h-2zM3 5h2v1h-2zM6 5h2v1h-2zM0 6h8v1h-8zM1 7h6v1h-6z', runes.length],
  ['/gems', 'Gems', 'M1 1h6v1h-6zM0 2h2v1h-2zM3 2h5v1h-5zM0 3h8v1h-8zM1 4h6v1h-6zM2 5h4v1h-4zM3 6h2v1h-2z', gems.length],
  ['/auras', 'Augments', 'M4 0h1v1h-1zM3 1h3v1h-3zM3 2h3v1h-3zM1 3h1v1h-1zM3 3h3v1h-3zM0 4h3v1h-3zM4 4h3v1h-3zM0 5h3v1h-3zM4 5h3v1h-3zM0 6h3v1h-3zM4 6h3v1h-3zM1 7h1v1h-1zM4 7h2v1h-2z', auras.length],
  ['/supports', 'Support gems', 'M2 0h4v1h-4zM1 1h6v1h-6zM1 2h1v1h-1zM3 2h4v1h-4zM1 3h6v1h-6zM2 4h4v1h-4zM0 5h1v1h-1zM7 5h1v1h-1zM0 6h2v1h-2zM6 6h2v1h-2zM1 7h6v1h-6z', supports.length],
  ['/infusions', 'Infusions', 'M0 0h8v1h-8zM0 1h1v1h-1zM2 1h4v1h-4zM7 1h1v1h-1zM1 2h6v1h-6zM1 3h4v1h-4zM6 3h1v1h-1zM1 4h3v1h-3zM5 4h2v1h-2zM1 5h2v1h-2zM4 5h3v1h-3zM1 6h6v1h-6zM1 7h6v1h-6z', infusions.length],
  ['/jewels', 'Jewels', 'M2 0h4v1h-4zM1 1h1v1h-1zM6 1h1v1h-1zM0 2h1v1h-1zM3 2h2v1h-2zM7 2h1v1h-1zM0 3h1v1h-1zM2 3h4v1h-4zM7 3h1v1h-1zM0 4h1v1h-1zM2 4h4v1h-4zM7 4h1v1h-1zM0 5h1v1h-1zM3 5h2v1h-2zM7 5h1v1h-1zM1 6h1v1h-1zM6 6h1v1h-1zM2 7h4v1h-4z', Object.values(jewelAffixes).flat().length],
  ['/talents', 'Talents', 'M2 0h4v1h-4zM1 1h6v1h-6zM0 2h3v1h-3zM5 2h3v1h-3zM0 3h2v1h-2zM6 3h2v1h-2zM0 4h2v1h-2zM6 4h2v1h-2zM0 5h3v1h-3zM5 5h3v1h-3zM1 6h6v1h-6zM2 7h4v1h-4z', talents.nodes.length],
  ['/spells', 'Spells', 'M6 0h2v1h-2zM4 1h3v1h-3zM2 2h5v1h-5zM1 3h6v1h-6zM0 4h3v1h-3zM5 4h2v1h-2zM0 5h3v1h-3zM5 5h2v1h-2zM0 6h6v1h-6zM1 7h4v1h-4z', spells.length],
  ['/stats', 'Stats', 'M6 0h2v1h-2zM6 1h2v1h-2zM3 2h2v1h-2zM6 2h2v1h-2zM3 3h2v1h-2zM6 3h2v1h-2zM0 4h2v1h-2zM3 4h2v1h-2zM6 4h2v1h-2zM0 5h2v1h-2zM3 5h2v1h-2zM6 5h2v1h-2zM0 6h2v1h-2zM3 6h2v1h-2zM6 6h2v1h-2z', stats.length],
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17191a" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CTE2 Database" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CTE2 Database: gear planner, affixes, uniques, runes, gems and stats for Craft to Exile 2" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="font" type="font/woff2" href={headingFont} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={bodyFont} crossorigin />
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <rect x="7" y="0" width="6" height="6"></rect>
            <rect x="0" y="7" width="6" height="6"></rect>
            <rect x="14" y="7" width="6" height="6"></rect>
            <rect x="7" y="14" width="6" height="6"></rect>
            <rect class="core" x="7" y="7" width="6" height="6"></rect>
          </svg>
          <span>CTE2 Database</span>
        </a>
        <button class="btn menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
          <svg viewBox="0 0 7 5" width="21" height="15" shape-rendering="crispEdges" aria-hidden="true">
            <path fill="currentColor" d="M0 0h7v1h-7zM0 2h7v1h-7zM0 4h7v1h-7z"></path>
          </svg>
        </button>
        <nav id="site-nav" aria-label="Sections">
          {
            nav.map(([href, label, icon, count]) => (
              <a class="tab" href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                <svg viewBox="0 0 8 8" width="16" height="16" shape-rendering="crispEdges" aria-hidden="true">
                  <path fill="currentColor" d={icon} />
                </svg>
                {label}
                {count && <span class="tab-count">{count}</span>}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <main class="wrap page">
      <slot />
      <footer class="site-footer">
        <div>
          A fan-made database for Craft to Exile 2, not affiliated with the modpack or Mine and Slash.
          <div class="credit">
            Made by seria with
            <svg viewBox="0 0 7 6" width="14" height="12" shape-rendering="crispEdges" role="img" aria-label="love">
              <path fill="currentColor" d="M1 0h2v1h-2zM4 0h2v1h-2zM0 1h7v2h-7zM1 3h5v1h-5zM2 4h3v1h-3zM3 5h1v1h-1z"></path>
            </svg>
          </div>
        </div>
        <nav aria-label="Project">
          <a href="https://github.com/seriaati/cte2-db" target="_blank" rel="noopener">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
              <path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
              ></path>
            </svg>
            GitHub
          </a>
          <a href="https://link.seria.moe/donate" target="_blank" rel="noopener">
            <svg viewBox="0 0 7 6" width="14" height="12" shape-rendering="crispEdges" aria-hidden="true">
              <path fill="currentColor" d="M1 0h2v1h-2zM4 0h2v1h-2zM0 1h7v2h-7zM1 3h5v1h-5zM2 4h3v1h-3zM3 5h1v1h-1z"></path>
            </svg>
            Sponsor
          </a>
        </nav>
      </footer>
    </main>
    <aside class="sponsor-prompt" aria-label="Sponsor the site" hidden>
      <strong>Getting good use out of this?</strong>
      <p>The site is free and has no ads. If it has helped you, you can sponsor its upkeep.</p>
      <div>
        <a class="btn primary" href="https://link.seria.moe/donate" target="_blank" rel="noopener" data-sponsor-answered>Sponsor</a>
        <button class="btn" type="button" data-sponsor-answered>No thanks</button>
      </div>
    </aside>
    <script>
      // Asks once, after ten minutes of the site being open and visible, counted across visits.
      const ASK_AFTER = 600;
      const TICK = 15;
      // Storage access throws when the browser blocks it; then the prompt simply never shows.
      const read = (key: string) => {
        try {
          return localStorage.getItem(key);
        } catch {
          return null;
        }
      };
      const write = (key: string, value: string) => {
        try {
          localStorage.setItem(key, value);
        } catch {}
      };
      const update = () => {
        const due = Number(read('usedSeconds')) >= ASK_AFTER && !read('sponsorAnswered');
        document.querySelector<HTMLElement>('.sponsor-prompt')!.hidden = !due;
      };

      setInterval(() => {
        if (document.visibilityState !== 'visible') return;
        write('usedSeconds', `${Number(read('usedSeconds')) + TICK}`);
        update();
      }, TICK * 1000);
      // Page changes swap the body, so the prompt is found again each time instead of being held on to.
      document.addEventListener('astro:page-load', update);
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') document.querySelector('[data-menu-toggle]')!.setAttribute('aria-expanded', 'false');
      });
      document.addEventListener('click', (e) => {
        const target = e.target as Element;
        // The menu button toggles the menu; a click anywhere else closes it.
        const menu = document.querySelector('[data-menu-toggle]')!;
        const opening = target.closest('[data-menu-toggle]') && menu.getAttribute('aria-expanded') !== 'true';
        menu.setAttribute('aria-expanded', `${!!opening}`);
        if (!target.closest('[data-sponsor-answered]')) return;
        write('sponsorAnswered', '1');
        update();
      });
    </script>
  </body>
</html>
